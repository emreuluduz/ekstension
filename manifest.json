{
    "manifest_version": 3,
    "name": "__MSG_extension_name__",
    "description": "__MSG_extension_description__",
    "version": "1.0.0",
    "default_locale": "tr",
    "permissions": [
        "storage",
        "contextMenus",
        "tabs",
        "offscreen",
        "declarativeNetRequest"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "host_permissions": [
        "https://eksisozluk.com/*",
        "https://*.youtube.com/*",
        "https://*.wikipedia.org/*",
        "https://*.imdb.com/*",
        "https://*.steampowered.com/*",
        "https://*.epicgames.com/*"
    ],
    "action": {
        "default_popup": "src/actions/index.html",
        "default_icon": {
            "16": "icons/icon_16.png",
            "48": "icons/icon_48.png",
            "128": "icons/icon_128.png"
        }
    },
    "background": {
        "service_worker": "src/background/background.js",
        "type": "module"
    },
    "icons": {
        "16": "icons/icon_16.png",
        "48": "icons/icon_48.png",
        "128": "icons/icon_128.png"
    },
    "web_accessible_resources": [{
        "resources": [
            "icons/icon_48.png"
        ],
        "matches": [
            "https://*.youtube.com/*",
            "https://*.wikipedia.org/*",
            "https://*.imdb.com/*",
            "https://*.steampowered.com/*",
            "https://*.epicgames.com/*"
        ]
    }],
    "content_scripts": [
        {
            "matches": ["*://*.eksisozluk.com/*"],
            "all_frames": true,
            "css": ["src/content/content.css"],
            "js": [
                "src/content/filter.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.youtube.com/*",
                "https://*.wikipedia.org/*",
                "https://*.imdb.com/*",
                "https://*.steampowered.com/*",
                "https://*.epicgames.com/*"
            ],
            "css": ["src/content/content.css"],
            "js": ["src/content/content.js"]
        }
    ]
}